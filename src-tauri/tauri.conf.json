{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NBSP",
  "version": "0.1.1",
  "identifier": "com.rens.nbsp",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "lib/libpdfium.so": "lib/libpdfium.so",
      "resources/cups/install.sh": "cups/install.sh",
      "resources/cups/nbsp-backend": "cups/nbsp-backend",
      "resources/cups/nbsp.ppd": "cups/nbsp.ppd"
    },
    "linux": {
      "rpm": {
        "depends": [
          "cups-client",
          "curl",
          "sane-backends"
        ],
        "recommends": [
          "epsonscan2",
          "gutenprint",
          "libreoffice-writer"
        ],
        "files": {
          "/usr/share/bash-completion/completions/nbsp": "target/completions/nbsp.bash",
          "/usr/share/zsh/site-functions/_nbsp": "target/completions/_nbsp",
          "/usr/share/fish/vendor_completions.d/nbsp.fish": "target/completions/nbsp.fish"
        },
        "desktopTemplate": "nbsp.desktop"
      },
      "deb": {
        "depends": [
          "cups-client",
          "curl",
          "sane-utils"
        ],
        "recommends": [
          "libreoffice-writer"
        ],
        "files": {
          "/usr/share/bash-completion/completions/nbsp": "target/completions/nbsp.bash",
          "/usr/share/zsh/site-functions/_nbsp": "target/completions/_nbsp",
          "/usr/share/fish/vendor_completions.d/nbsp.fish": "target/completions/nbsp.fish"
        },
        "desktopTemplate": "nbsp.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "role": "Viewer"
      },
      {
        "ext": [
          "png"
        ],
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "ext": [
          "docx"
        ],
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Viewer"
      },
      {
        "ext": [
          "odt"
        ],
        "mimeType": "application/vnd.oasis.opendocument.text",
        "role": "Viewer"
      }
    ],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Print, impose and scan",
    "longDescription": "No Bull-Shit Print: n-up, booklets, double-sided (guided flip without a duplexer), margins, page editing, scanning and Epson maintenance, for any CUPS printer and SANE scanner."
  }
}
